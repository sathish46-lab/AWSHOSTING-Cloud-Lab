# ----------------------------------------------------------------------
# FIXED PROFESSIONAL ROUTING
# ----------------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Custom 404 Error Handler - Secure against server information disclosure
ErrorDocument 404 /app/error.php

# 1. Force HTTPS - COMMENT THESE OUT TO AVOID REDIRECT LOOPS
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block sensitive config files from web access
RewriteRule ^env\.json$ - [F,L]
RewriteRule ^session\.json$ - [F,L]
RewriteRule ^ip\.json$ - [F,L]

# Block debug API files from web access
RewriteRule ^src/api/debug_ - [F,L]

# 2. Skip real files
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# MCP OAuth + Inspector — served by PHP (NOT proxied to Python MCP server)
RewriteRule ^mcp/inspector/?$ app/mcp.php [L,QSA]
RewriteRule ^mcp/authorize/?$ src/api/mcp/authorize.php [L,QSA]
RewriteRule ^mcp/consent/?$ src/api/mcp/consent.php [L,QSA]
RewriteRule ^mcp/token/?$ src/api/mcp/token.php [L,QSA]
RewriteRule ^mcp/revoke/?$ src/api/mcp/revoke.php [L,QSA]
RewriteRule ^mcp/register/?$ src/api/mcp/register.php [L,QSA]
RewriteRule ^mcp/metadata/?$ src/api/mcp/metadata.php [L,QSA]
RewriteRule ^mcp/clients/?$ src/api/mcp/clients.php [L,QSA]
RewriteRule ^mcp/activity/data/?$ src/api/mcp/activity.php [L,QSA]

# OAuth well-known discovery endpoints
RewriteRule ^\.well-known/oauth-authorization-server/?$ src/api/mcp/metadata.php [L,QSA]
RewriteCond %{REQUEST_METHOD} =GET [OR]
RewriteCond %{REQUEST_METHOD} =OPTIONS
RewriteRule ^\.well-known/oauth-protected-resource/mcp/?$ http://127.0.0.1:8099/.well-known/oauth-protected-resource/mcp [P,L,QSA]

# /mcp exact path: browser GET = PHP inspector UI, POST/SSE = MCP protocol (proxied to Python)
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^mcp/?$ http://127.0.0.1:8099/mcp [P,L,QSA]
RewriteCond %{HTTP:Accept} text/event-stream [NC]
RewriteRule ^mcp/?$ http://127.0.0.1:8099/mcp [P,L,QSA]
RewriteRule ^mcp/?$ app/mcp.php [L,QSA]

# /mcp/activity page route
RewriteRule ^mcp/activity/?$ app/mcp-activity.php [L,QSA]

# 3. Authentication Routing
RewriteRule ^signin$ auth/signin.php [L,QSA]
RewriteRule ^signup$ auth/signup.php [L,QSA]
RewriteRule ^logout$ auth/logout.php [L,QSA]
RewriteRule ^forgot$ auth/forgot.php [L,QSA]
RewriteRule ^reset$ auth/reset.php [L,QSA]

# 4. Intelligent Folder Routing
RewriteCond %{DOCUMENT_ROOT}/auth/$1.php -f
RewriteRule ^([^/]+)$ auth/$1.php [L,QSA]

RewriteCond %{DOCUMENT_ROOT}/app/$1.php -f
RewriteRule ^([^/]+)$ app/$1.php [L,QSA]

# Admin/Superuser Routing
RewriteRule ^admin/?$ app/admin/dashboard.php [L,QSA]
RewriteRule ^admin/users/?$ app/admin/users.php [L,QSA]
RewriteRule ^admin/server-monitor/?$ app/admin/server_monitor.php [L,QSA]
RewriteRule ^admin/api/?$ app/admin/api.php [L,QSA]
RewriteRule ^admin/user/([^/]+)/?$ app/admin/user_view.php?email=$1 [L,QSA]

RewriteRule ^home$ app/home.php [L,QSA]

# 8. Services Routing
RewriteRule ^services$ app/services.php [L,QSA]

# Network Interfaces
RewriteRule ^network/interfaces/?$ app/network/interfaces.php [L,QSA]

# MySQL
RewriteRule ^services/mysql$ app/services/mysql/dashboard.php [L,QSA]
RewriteRule ^services/mysql/database$ app/services/mysql/database.php [L,QSA]

# PostgreSQL
RewriteRule ^services/postgresql$ app/services/postgresql/dashboard.php [L,QSA]
RewriteRule ^services/postgresql/database$ app/services/postgresql/database.php [L,QSA]

# MongoDB
RewriteRule ^services/mongodb$ app/services/mongodb/dashboard.php [L,QSA]
RewriteRule ^services/mongodb/database$ app/services/mongodb/database.php [L,QSA]

# RabbitMQ
RewriteRule ^services/rabbitmq$ app/services/rabbitmq/dashboard.php [L,QSA]
RewriteRule ^services/rabbitmq/vhost$ app/services/rabbitmq/vhost.php [L,QSA]

# Redis
RewriteRule ^services/redis$ app/services/redis/dashboard.php [L,QSA]

# 3. Quiz Module Routing (AI Powered)
RewriteRule ^quiz/v/([a-f0-9]+)/?$ app/quiz/v.php?hash=$1 [L,QSA]
RewriteRule ^quiz/generate/?$ app/quiz/generate.php [L,QSA]
RewriteRule ^quiz/([a-zA-Z0-9-]+)/(Recent|trending|completed|leaderboard)/([a-zA-Z0-9-]+)/?$ app/quiz/start.php?parent=$1&tab=$2&topic_id=$3 [L,QSA]
RewriteRule ^quiz/([a-zA-Z0-9-]+)/(Recent|trending|completed|leaderboard)/?$ app/quiz/quiz_view.php?id=$1&tab=$2 [L,QSA]
RewriteRule ^quiz/([a-zA-Z0-9-]+)/?$ app/quiz/quiz_view.php?id=$1 [L,QSA]
RewriteRule ^quiz$ app/quiz/quiz_hub.php [L,QSA]

# 7. Learn AI Routing
RewriteRule ^learn$ app/learnAI/dashboard.php [L,QSA]
RewriteRule ^learn/lesson/([^/]+)$ app/learnAI/course_view.php?id=$1 [L,QSA]
RewriteRule ^learn/lesson/([^/]+)/map$ app/learnAI/course_view.php?id=$1&view=map [L,QSA]
RewriteRule ^learn/lesson/([^/]+)/chapter/([^/]+)$ app/learnAI/course_view.php?id=$1&chapter_id=$2 [L,QSA]

# 8. System User Files Routing (Avatar & Private)
RewriteRule ^system/user/(avatar|private)/([a-zA-Z0-9_-]+)/(.+)$ src/api/system/user_files.php?type=$1&user_id=$2&filename=$3 [L,QSA]

# 9. Network Interfaces Routing
RewriteRule ^network/interfaces/?$ app/network/interfaces.php [L,QSA]

# 10. Instances Routing
RewriteRule ^instances$ instances/templates [L,QSA]
RewriteRule ^instances/templates$ app/instances/dashboard.php [L,QSA]
RewriteRule ^instances/trash$ app/instances/dashboard.php [L,QSA]
RewriteRule ^instances/([^/]+)/([^/]+)$ app/instances/manage.php?slug=$1&tab=$2 [L,QSA]
RewriteRule ^instances/([^/]+)$ app/instances/manage.php?slug=$1 [L,QSA]

# ------------------------------------------------------------------
# Roadmaps Routing (before catch-all user profile)
# ------------------------------------------------------------------
RewriteRule ^roadmaps$ app/roadmaps/dashboard.php [L,QSA]
RewriteRule ^roadmaps/new/?$ app/roadmaps/new.php [L,QSA]
RewriteRule ^roadmaps/([a-z0-9-]+)/?$ app/roadmaps/roadmap_view.php?slug=$1 [L,QSA]

# 5. USER PROFILE ROUTING
RewriteCond %{DOCUMENT_ROOT}/app/account.php -f
RewriteRule ^([a-zA-Z0-9_.-]+)$ app/account.php?username=$1 [L,QSA]

# 6. API ROUTING (Consolidated src/api/)
# Handle requests that already include .php extension
RewriteRule ^api/(.+\.php)$ src/api/$1 [L,QSA]
# Handle extensionless requests
RewriteRule ^api/(.+)$ src/api/$1.php [L,QSA]


# 1. Existing Lab Tabs (Dashboard, Domains, Prefs)
RewriteRule ^labs/(dashboard|domains|preferences|activity)/([a-f0-9]{32})$ app/labs/$1.php [L,QSA]

# Lab Deploy Progress API
RewriteRule ^api/lab/deploy_progress/?$ src/api/lab/deploy_progress.php [L,QSA]

# ------------------------------------------------------------------
# Challenge Routing — Pattern: /challenges/{tab}/{hash-or-slug}
# ------------------------------------------------------------------

# Redirect /labs/challenges/... to /challenges/... (Compatibility)
RewriteRule ^labs/(challenges|leaderboard|dashboard|achievements)/([a-zA-Z0-9_-]+)$ challenges/$1/$2 [R=301,L]

# Challenge Tabs
# Pattern: /challenges/{tab}/{hash}
RewriteRule ^challenges/(dashboard|challenges|leaderboard|achievements)/([a-f0-9]{32})$ app/challenges/$1.php [L,QSA]

# Pattern: /challenges/{tab}/{slug}
RewriteRule ^challenges/(dashboard|challenges|leaderboard|achievements)/([a-zA-Z0-9_-]+)$ app/challenges/$1.php [L,QSA]

# Global Leaderboard Fallback
RewriteRule ^leaderboard/([a-f0-9]{32})$        app/challenges/leaderboard.php [L,QSA]
RewriteRule ^leaderboard/([a-zA-Z0-9_-]+)$      app/challenges/leaderboard.php [L,QSA]

